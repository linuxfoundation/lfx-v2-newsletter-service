# LFX v2 Newsletter Service environment variables
# Copy to .env and set values for your environment.

# -----------------------------
# Core server
# -----------------------------
PORT=8080
LOG_LEVEL=info
# Optional (used by internal logging package): true|false
LOG_ADD_SOURCE=false

# -----------------------------
# CMS provider selection
# -----------------------------
CMS_PROVIDER=ghost
CMS_TIMEOUT=30s

# -----------------------------
# Ghost provider (required when CMS_PROVIDER=ghost)
# -----------------------------
GHOST_API_BASE_URL=https://linuxfoundation.ghost.io
GHOST_API_KEY=replace-with-ghost-content-api-key
GHOST_API_TIMEOUT=30s
GHOST_CACHE_TTL=300s
GHOST_MAX_RESULTS_PER_PAGE=100

# -----------------------------
# Inbound JWT auth (required)
# -----------------------------
# Production/staging: set JWKS_URL and keep mock principal empty.
JWKS_URL=https://heimdall.example.com/.well-known/jwks.json
JWT_AUDIENCE=lfx-v2-newsletter-service
JWT_ISSUER=heimdall
JWT_CLOCK_SKEW=5s

# Local-only bypass. Leave empty in non-dev environments.
JWT_AUTH_DISABLED_MOCK_LOCAL_PRINCIPAL=

# -----------------------------
# OpenTelemetry (optional)
# -----------------------------
OTEL_SERVICE_NAME=lfx-v2-newsletter-service
OTEL_SERVICE_VERSION=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Traces
OTEL_TRACES_EXPORTER=none
OTEL_TRACES_SAMPLE_RATIO=1.0

# Metrics and logs exporters (used by pkg/utils/otel)
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
