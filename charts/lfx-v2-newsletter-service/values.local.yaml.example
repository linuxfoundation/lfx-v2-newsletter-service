---
# Example overrides for local development against an OrbStack / kind cluster.
# Copy to values.local.yaml and adjust as needed.

image:
  repository: ko.local/newsletter-api
  tag: local
  pullPolicy: Never

replicaCount: 1

app:
  logLevel: debug
  # Committee members are read from the query service as the service itself.
  # The M2M client ID and private key come from a Kubernetes Secret you create
  # for the cluster, e.g. kubectl create secret generic newsletter-m2m
  # --from-literal=auth0_client_id=... --from-file=auth0_client_private_key=key.pem
  queryService:
    url: "http://lfx-api.lfx.svc.cluster.local"
  m2mAuth:
    domain: "example.auth0.com"
    audience: "http://lfx-api.lfx.svc.cluster.local"
    clientIDSecretRef:
      name: newsletter-m2m
    privateKeySecretRef:
      name: newsletter-m2m
  requireUserAuth: false   # local dev only; production must validate JWTs
  jwksURL: ""

# Standalone local deployment: chart provisions both the Cluster and the Database CRs.
database:
  mode: cluster+database
  cloudNativePG:
    clusterName: lfx-newsletter-db
    databaseName: newsletters
    cluster:
      instances: 1
      storage:
        size: 1Gi

networkPolicy:
  enabled: false   # easier debugging in local clusters
